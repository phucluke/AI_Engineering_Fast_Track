# OpenAI-compatible client. Copy to .env. Never commit .env.
# Direct OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter (same SDK; only key / base_url / model change):
#   OPENAI_API_KEY=sk-or-...
#   OPENAI_MODEL=openai/gpt-4o-mini
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace_at_runtime_never_commit
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional
# OPENAI_TIMEOUT_SEC=30
# OPENAI_MAX_RETRIES=3
# OPENAI_HTTP_REFERER=
# OPENAI_APP_TITLE=MeetingNotesAPI

DATABASE_URL=postgresql://training:training@localhost:5432/aibootcamp
