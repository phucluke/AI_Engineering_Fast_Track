# Week 1 classifier. Copy to .env. Never commit .env.
OPENROUTER_API_KEY=replace_at_runtime_never_commit
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Later weeks. The Week 1 classifier does not read these.
OPENAI_API_KEY=replace_at_runtime_never_commit
OPENAI_MODEL=choose_approved_model
DATABASE_URL=postgresql://training:training@localhost:5432/aibootcamp
